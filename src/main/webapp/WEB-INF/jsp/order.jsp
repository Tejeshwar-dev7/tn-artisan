<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/head.jspf" %>
<section class="container section-pad order-tracking-page"><a class="text-link" href="/account">&#8592; My orders</a><div class="tracking-heading"><div><div class="eyebrow">TN ARTISAN &#183; ORDER AC-<c:out value="${order.id}"/></div><h1 class="page-title">Follow your craft's journey.</h1><p>Placed <c:out value="${order.createdAt}"/></p></div><span id="order-status" class="tracking-status"><c:out value="${order.status}"/></span></div>
<c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if>
<div class="tracking-summary-grid"><article class="panel"><small>ORDER TOTAL</small><strong>&#8377;<fmt:formatNumber value="${order.total}" groupingUsed="true" minFractionDigits="2" maxFractionDigits="2"/></strong><span><c:out value="${order.items.size()}"/> product line(s)</span></article><article class="panel"><small>PAYMENT STATUS</small><strong id="payment-status"><c:out value="${order.paymentStatus}"/></strong><span><c:choose><c:when test="${order.paymentMethod eq 'RAZORPAY'}">Razorpay &#183; UPI/cards as available</c:when><c:otherwise>Cash on delivery</c:otherwise></c:choose></span></article><article class="panel"><small>EXPECTED ARRIVAL</small><strong><c:choose><c:when test="${not empty order.expectedDeliveryAt}"><time class="friendly-date" datetime="<c:out value='${order.expectedDeliveryAt}'/>"><c:out value="${order.expectedDeliveryAt}"/></time></c:when><c:otherwise>To be confirmed</c:otherwise></c:choose></strong><span>Estimate &#183; maker or courier updates can change it</span></article></div>
<div class="tracking-layout"><div class="tracking-main"><section class="panel"><div class="section-heading"><div><div class="eyebrow">Live order record</div><h2>Journey updates</h2></div><span class="poll-indicator"><i></i> Refreshes automatically</span></div><div id="order-timeline" class="tracking-timeline"><c:forEach items="${events}" var="e"><article class="tracking-event"><i></i><div><b><c:out value="${e.status}"/></b><p><c:out value="${e.note}"/></p><time><c:out value="${e.createdAt}"/></time></div></article></c:forEach></div><p class="muted-copy" id="tracking-poll-message">Order and courier details update from saved order events every 20 seconds while this page is open.</p></section>
<section class="panel shipment-panel"><div class="eyebrow">Delivery partner</div><h2>Shipment details</h2><c:choose><c:when test="${not empty order.trackingNumber}"><dl class="shipment-details"><div><dt>Courier</dt><dd><c:out value="${order.courierName}"/></dd></div><div><dt>Tracking reference</dt><dd><c:out value="${order.trackingNumber}"/></dd></div><div><dt>Dispatched</dt><dd><c:choose><c:when test="${not empty order.dispatchedAt}"><c:out value="${order.dispatchedAt}"/></c:when><c:otherwise>Not yet dispatched</c:otherwise></c:choose></dd></div><div><dt>Latest artisan / courier report</dt><dd id="latest-location"><c:out value="${order.latestShipmentLocation}" default="No location update reported yet"/></dd></div></dl><c:if test="${not empty order.externalTrackingUrl}"><a class="btn btn-outline-dark rounded-pill" href="<c:out value='${order.externalTrackingUrl}'/>" target="_blank" rel="noopener">Open courier tracking &#8599;</a></c:if></c:when><c:otherwise><p>No shipment reference has been added yet. The maker will add one when your order is dispatched.</p></c:otherwise></c:choose></section>
<section class="panel"><div class="eyebrow">The pieces in your parcel</div><h2>Product details</h2><c:forEach items="${order.items}" var="i"><article class="tracking-product"><a href="/products/${i.product.id}"><img src="<c:out value='${i.product.imageUrl}'/>" alt="<c:out value='${i.product.name}'/>"></a><div><a href="/products/${i.product.id}"><b><c:out value="${i.product.name}"/></b></a><span>Made by <c:out value="${i.artisan.name}"/> &#183; <c:out value="${i.product.district}"/></span><span>Quantity <c:out value="${i.quantity}"/> &#215; &#8377;<fmt:formatNumber value="${i.unitPrice}" groupingUsed="true" minFractionDigits="2" maxFractionDigits="2"/></span></div><strong>&#8377;<fmt:formatNumber value="${i.lineTotal}" groupingUsed="true" minFractionDigits="2" maxFractionDigits="2"/></strong></article></c:forEach></section>
<section class="panel"><div class="eyebrow">Shipping / drop address</div><h2><c:out value="${order.recipientName}"/></h2><address class="shipping-address"><c:out value="${order.addressLine1}"/><c:if test="${not empty order.addressLine2}">, <c:out value="${order.addressLine2}"/></c:if><br><c:out value="${order.deliveryCity}"/>, <c:out value="${order.deliveryDistrict}"/><br><c:out value="${order.deliveryState}"/> &#183; <c:out value="${order.deliveryPostalCode}"/><br>Phone &#183; <c:out value="${order.deliveryPhone}"/></address></section></div>
<aside class="tracking-aside"><section class="panel"><div class="eyebrow">Your delivery area</div><h2>Map</h2><div id="delivery-map" class="delivery-map" data-query="<c:out value='${order.deliveryCity}, ${order.deliveryDistrict}, ${order.deliveryState}, India'/>"></div><small class="map-caption">Map pin marks the delivery locality, not live courier GPS. <a href="https://www.openstreetmap.org/search?query=<c:out value='${order.deliveryCity}, ${order.deliveryDistrict}, ${order.deliveryState}'/>" target="_blank" rel="noopener">Open map &#8599;</a></small><p id="map-result" class="map-result">Loading map for your delivery area…</p></section><section class="panel payment-record"><div class="eyebrow">Payment details</div><h2>Receipt</h2><dl><div><dt>Method</dt><dd><c:out value="${order.paymentMethod}"/></dd></div><div><dt>Status</dt><dd id="payment-status-secondary"><c:out value="${order.paymentStatus}"/></dd></div><div><dt>Reference</dt><dd><c:choose><c:when test="${not empty order.paymentReference}"><c:out value="${order.paymentReference}"/></c:when><c:when test="${order.paymentMethod eq 'COD'}">Due on delivery</c:when><c:otherwise>Awaiting provider confirmation</c:otherwise></c:choose></dd></div><div class="payment-record-total"><dt>Total paid / due</dt><dd>&#8377;<fmt:formatNumber value="${order.total}" groupingUsed="true" minFractionDigits="2" maxFractionDigits="2"/></dd></div></dl></section></aside></div>
<c:if test="${reviewable}"><div class="panel mt-4 review-cta"><div><div class="eyebrow">Delivered</div><h2>Tell the maker what you think.</h2></div><a href="/products/${order.items[0].product.id}#reviews" class="btn btn-terracotta rounded-pill">Write a product review</a></div></c:if>
<div id="tracking-config" hidden data-url="/customer/orders/${order.id}/tracking-data"></div></section>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script><script>
document.querySelectorAll(".friendly-date").forEach(el=>{const d=new Date(el.dateTime);if(!isNaN(d))el.textContent=d.toLocaleDateString("en-IN",{day:"numeric",month:"short",year:"numeric"});});
(()=>{const mapNode=document.getElementById('delivery-map');if(!mapNode)return;const query=mapNode.dataset.query;const result=document.getElementById('map-result');if(!window.L){result.textContent='Map tiles did not load. Use the Open map link to view the delivery locality.';return;}const map=L.map(mapNode,{scrollWheelZoom:false}).setView([11.1271,78.6569],6);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q='+encodeURIComponent(query),{headers:{'Accept':'application/json'}}).then(r=>{if(!r.ok)throw Error('Map search unavailable');return r.json();}).then(rows=>{if(!rows.length)throw Error('Locality not found');const pin=[Number(rows[0].lat),Number(rows[0].lon)];map.setView(pin,12);L.marker(pin).addTo(map).bindPopup('Delivery locality').openPopup();result.textContent='Showing '+rows[0].display_name+' &#183; exact street address stays in your private order details.';}).catch(()=>{result.textContent='Map is centered on Tamil Nadu. The exact delivery locality was not found; the full drop address remains in your order details.';});})();
(()=>{const config=document.getElementById('tracking-config');const timeline=document.getElementById('order-timeline');const status=document.getElementById('order-status');const pay=document.getElementById('payment-status');const pay2=document.getElementById('payment-status-secondary');const location=document.getElementById('latest-location');if(!config)return;async function refresh(){try{const response=await fetch(config.dataset.url,{headers:{'Accept':'application/json'},cache:'no-store'});if(!response.ok)throw Error('Could not refresh');const data=await response.json();status.textContent=data.status.replaceAll('_',' ');pay.textContent=data.paymentStatus;pay2.textContent=data.paymentStatus;if(location&&data.latestLocation)location.textContent=data.latestLocation;timeline.replaceChildren(...data.events.map(e=>{const article=document.createElement('article');article.className='tracking-event';const dot=document.createElement('i');const body=document.createElement('div');const title=document.createElement('b');title.textContent=e.status.replaceAll('_',' ');const note=document.createElement('p');note.textContent=e.note;const time=document.createElement('time');time.textContent=new Date(e.createdAt).toLocaleString();body.append(title,note,time);article.append(dot,body);return article;}));}catch{document.getElementById('tracking-poll-message').textContent='Could not refresh just now. Your saved updates remain visible; retrying shortly.';}}setInterval(refresh,20000);})();
</script><%@ include file="fragments/foot.jspf" %>
