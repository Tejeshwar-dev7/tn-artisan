<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="container section-pad narrow"><a href="/account" class="text-link">&#8592; My orders</a><div class="eyebrow mt-4">Customer account</div><h1 class="page-title">Your profile and delivery details.</h1><p>Saved contact details help fill checkout faster. You can still change the drop address for every order.</p><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><form class="panel profile-form" method="post" action="/customer/profile"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Name<input class="form-control" name="name" maxlength="120" value="<c:out value='${customer.name}'/>" required></label><label>Email<input class="form-control" value="<c:out value='${customer.email}'/>" disabled></label><label>Phone<input class="form-control" name="phone" value="<c:out value='${customer.phone}'/>" pattern="[+0-9() -]{7,25}" required></label><label>Default address line 1<input class="form-control" name="addressLine1" value="<c:out value='${customer.addressLine1}'/>" maxlength="180" required></label><label>Address line 2<input class="form-control" name="addressLine2" value="<c:out value='${customer.addressLine2}'/>" maxlength="180"></label><div class="profile-grid"><label>City<input class="form-control" name="city" value="<c:out value='${customer.city}'/>" required></label><label>District<input class="form-control" name="district" value="<c:out value='${customer.district}'/>" required></label><label>State<input class="form-control" name="state" value="<c:out value='${customer.state}'/>" required></label><label>PIN code<input class="form-control" name="postalCode" value="<c:out value='${customer.postalCode}'/>" pattern="[1-9][0-9]{5}" maxlength="6" required></label></div><button class="btn btn-terracotta mt-4">Save profile</button></form></section><%@ include file="fragments/foot.jspf" %>
