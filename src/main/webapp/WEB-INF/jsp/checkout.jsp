<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/head.jspf" %>
<section class="container section-pad checkout-page"><div class="eyebrow">TN ARTISAN · secure checkout</div><h1 class="page-title">Where should your craft arrive?</h1><p class="muted-copy">Add the delivery address and choose how you would like to pay.</p>
<c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}"/></div></c:if>
<div class="checkout-layout"><form id="delivery-form" class="checkout-address panel" method="post" action="/checkout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
<h2>Delivery address</h2><div class="checkout-fields">
<label>Recipient name<input class="form-control" name="recipientName" value="<c:out value='${customer.name}'/>" maxlength="120" autocomplete="name" required></label>
<label>Phone number<input class="form-control" name="phone" value="<c:out value='${customer.phone}'/>" maxlength="25" autocomplete="tel" pattern="[+0-9() -]{7,25}" required></label>
<label class="field-wide">Address line 1<input class="form-control" name="addressLine1" value="<c:out value='${customer.addressLine1}'/>" maxlength="180" autocomplete="address-line1" placeholder="House number and street" required></label>
<label class="field-wide">Address line 2 <span class="muted-copy">optional</span><input class="form-control" name="addressLine2" value="<c:out value='${customer.addressLine2}'/>" maxlength="180" autocomplete="address-line2" placeholder="Apartment, landmark, area"></label>
<label>City / town<input class="form-control" name="city" value="<c:out value='${customer.city}'/>" maxlength="100" autocomplete="address-level2" required></label>
<label>District<input class="form-control" name="district" value="<c:out value='${customer.district}'/>" maxlength="100" required></label>
<label>State<input class="form-control" name="state" value="<c:out value='${customer.state}'/>" maxlength="100" autocomplete="address-level1" required></label>
<label>PIN code<input class="form-control" name="postalCode" value="<c:out value='${customer.postalCode}'/>" inputmode="numeric" pattern="[1-9][0-9]{5}" maxlength="6" autocomplete="postal-code" required></label>
</div><h2 class="mt-4">Payment method</h2><label class="payment-choice"><input type="radio" name="paymentMethod" value="RAZORPAY" ${razorpayConfigured ? 'checked' : 'disabled'}><span><b>Pay online with Razorpay</b><small>Cards, net banking and UPI apps such as Google Pay when enabled on your merchant account.</small><c:if test="${!razorpayConfigured}"><small class="payment-unavailable">Online payments are unavailable until the site owner configures Razorpay test keys.</small></c:if></span></label>
<label class="payment-choice"><input type="radio" name="paymentMethod" value="COD" ${razorpayConfigured ? '' : 'checked'}><span><b>Cash on delivery</b><small>Pay the delivery partner when the parcel arrives.</small></span></label>
<button class="btn btn-terracotta checkout-submit" type="submit"><c:choose><c:when test="${razorpayConfigured}">Continue to payment</c:when><c:otherwise>Place cash on delivery order</c:otherwise></c:choose><span aria-hidden="true">&#8594;</span></button><p class="checkout-privacy">Your full delivery address is saved with this order and shown only to you and the assigned maker for fulfilment.</p></form>
<aside class="checkout-summary panel"><h2>Order summary</h2><c:forEach items="${rows}" var="r"><div class="checkout-item"><img src="<c:out value='${r.product.imageUrl}'/>" alt=""><div><b><c:out value="${r.product.name}"/></b><small>Qty <c:out value="${r.quantity}"/> · ₹<fmt:formatNumber value="${r.product.price}" groupingUsed="true" minFractionDigits="0" maxFractionDigits="0"/></small></div><b>₹<fmt:formatNumber value="${r.lineTotal}" groupingUsed="true" minFractionDigits="0" maxFractionDigits="0"/></b></div></c:forEach><div class="checkout-total"><span>Subtotal</span><b>₹<fmt:formatNumber value="${total}" groupingUsed="true" minFractionDigits="0" maxFractionDigits="0"/></b></div><div class="checkout-total"><span>Shipping</span><b>Included</b></div><div class="checkout-total total-grand"><span>Total</span><b>₹<fmt:formatNumber value="${total}" groupingUsed="true" minFractionDigits="0" maxFractionDigits="0"/></b></div><p>Delivery estimates and maker-confirmed product details appear in your order timeline.</p></aside></div></section>
<%@ include file="fragments/foot.jspf" %>
