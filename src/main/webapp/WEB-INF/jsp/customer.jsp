<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="container section-pad"><div class="account-heading"><div><div class="eyebrow">Customer account</div><h1 class="page-title">Your orders, in one place.</h1></div><a class="btn btn-outline-dark rounded-pill" href="/customer/profile">Your profile &amp; address &#8599;</a></div><c:forEach items="${orders}" var="o"><a class="order-row" href="/customer/orders/${o.id}"><div><b>Order #AC-<c:out value="${o.id}"/></b><div class="maker"><c:out value="${o.createdAt}"/> · Payment <c:out value="${o.paymentStatus}"/></div></div><span class="status-pill"><c:out value="${o.status}"/></span><b>&#8377;<c:out value="${o.total}"/></b></a></c:forEach><c:if test="${empty orders}"><div class="empty-state">Your first artisan-made find is waiting.<br><a class="btn btn-terracotta mt-3" href="/products">Browse the collection</a></div></c:if></section><%@ include file="fragments/foot.jspf" %>
