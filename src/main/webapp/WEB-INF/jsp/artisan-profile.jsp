<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="container section-pad narrow"><a href="/artisan-area" class="text-link">&#8592; Maker studio</a><div class="eyebrow mt-4">Artisan account</div><h1 class="page-title">Your workshop profile.</h1><a class="btn btn-outline-dark rounded-pill mb-3" href="/artisan/${profile.user.id}">View your public maker profile</a><div class="approval-panel"><span class="status-pill"><c:out value="${profile.status}"/></span><p><c:choose><c:when test="${profile.status eq 'APPROVED'}">Your approved listings can appear in the marketplace. Keep your maker story and contact details current.</c:when><c:when test="${profile.status eq 'PENDING'}">Your profile is awaiting administrator review. You can prepare your story; product publishing opens after approval.</c:when><c:otherwise>Your profile needs an administrator review before your products can be listed.</c:otherwise></c:choose></p><c:if test="${not empty profile.verificationNote}"><small><c:out value="${profile.verificationNote}"/></small></c:if></div><c:if test="${not empty success}"><div class="alert alert-success mt-3"><c:out value="${success}"/></div></c:if><form class="panel profile-form" method="post" action="/artisan/profile"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Studio or collective name<input class="form-control" name="shopName" maxlength="120" value="<c:out value='${profile.shopName}'/>" required></label><label>Craft tradition<input class="form-control" name="craft" maxlength="80" value="<c:out value='${profile.craft}'/>" required></label><label>District<input class="form-control" name="district" maxlength="120" value="<c:out value='${profile.district}'/>" required></label><label>Contact phone<input class="form-control" name="phone" value="<c:out value='${profile.phone}'/>" pattern="[+0-9() -]{7,25}" required></label><label>Your story<textarea class="form-control" name="story" rows="6" maxlength="600" required><c:out value="${profile.story}"/></textarea></label><button class="btn btn-terracotta mt-4">Save workshop profile</button></form></section><%@ include file="fragments/foot.jspf" %>
