<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="container section-pad"><div class="eyebrow">Your basket</div><h1 class="page-title">A few thoughtful finds.</h1><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}"/></div></c:if><c:if test="${param.customerRequired != null}"><div class="alert alert-info">Checkout requires a customer account. Sign out of your current account, then <a href="/login/customer">sign in as a customer</a>.</div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><c:choose><c:when test="${empty rows}"><div class="empty-state">Your basket is waiting for something made by hand.<br><a href="/products" class="btn btn-terracotta mt-3">Explore crafts</a></div></c:when><c:otherwise><div class="row g-4"><div class="col-lg-8"><c:forEach items="${rows}" var="r"><div class="cart-row"><img class="cart-thumb" style="object-fit:cover" src="<c:out value='${r.product.imageUrl}'/>" alt=""><div class="flex-grow-1"><a href="/products/${r.product.id}"><b><c:out value="${r.product.name}"/></b></a><div class="maker"><c:out value="${r.product.district}"/> &#183; &#8377;<c:out value="${r.product.price}"/></div></div><small><c:out value="${r.product.stock}"/> in stock</small><form method="post" action="/cart/update"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="productId" value="${r.product.id}"><input class="form-control qty" type="number" min="0" max="${r.product.stock}" name="quantity" value="${r.quantity}"><button class="btn btn-outline-secondary">Update</button></form></div></c:forEach></div><div class="col-lg-4"><div class="summary"><h3>Order summary</h3><b>Subtotal &#8377;<c:out value="${total}"/></b><a class="btn btn-terracotta w-100 mt-4" href="/checkout">Continue to checkout</a></div></div></div></c:otherwise></c:choose></section><%@ include file="fragments/foot.jspf" %>
