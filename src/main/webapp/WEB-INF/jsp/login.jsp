<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="auth-wrap"><div class="auth-card"><div class="eyebrow"><c:choose><c:when test="${loginRole eq 'ADMIN'}">Administrator access</c:when><c:when test="${loginRole eq 'ARTISAN'}">Artisan studio</c:when><c:when test="${loginRole eq 'CUSTOMER'}">Customer account</c:when><c:otherwise>Welcome to TN ARTISAN</c:otherwise></c:choose></div><h1><c:choose><c:when test="${loginRole eq 'ADMIN'}">Sign in to administration</c:when><c:when test="${loginRole eq 'ARTISAN'}">Sign in to your maker studio</c:when><c:when test="${loginRole eq 'CUSTOMER'}">Sign in to your customer account</c:when><c:otherwise>Sign in to your account</c:otherwise></c:choose></h1><c:if test="${param.error ne null}"><div class="alert alert-danger" role="alert">${loginRole eq 'ADMIN' ? 'Admin email or password is incorrect.' : 'Email or password is incorrect. Please try again.'}</div></c:if><c:if test="${param.roleMismatch ne null}"><div class="alert alert-warning" role="alert">This email is registered under another account type. Please use its matching sign-in page.</div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><c:if test="${not empty demoEmail}"><p><strong>Try the demo</strong><br>Email: <c:out value="${demoEmail}"/><br>Password: <c:out value="${demoPassword}"/><br><small>This shared account lets you browse the dashboard. Create your own account to place orders or publish products.</small></p></c:if><form method="post" action="/login"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><c:if test="${not empty loginRole}"><input type="hidden" name="expectedRole" value="${loginRole}"></c:if><label>Email</label><input class="form-control" type="email" name="username" value="<c:out value='${empty email and param.error eq null and param.roleMismatch eq null ? demoEmail : email}'/>" autocomplete="username" required><label>Password</label><input class="form-control" type="password" name="password" value="<c:out value='${empty email and param.error eq null and param.roleMismatch eq null ? demoPassword : null}'/>" required autocomplete="current-password"><button class="btn btn-terracotta w-100 mt-4">Sign in</button></form><p class="mt-3"><c:choose><c:when test="${loginRole eq 'ADMIN'}"><a href="/login">Back to account sign in</a></c:when><c:when test="${loginRole eq 'ARTISAN'}">New maker? <a href="/register/artisan">Create an artisan account</a></c:when><c:when test="${loginRole eq 'CUSTOMER'}">New to TN ARTISAN? <a href="/register/customer">Create a customer account</a><br><a href="/login/admin">Admin sign-in</a> · <a href="/login/artisan">Maker sign-in</a></c:when><c:otherwise>Administrator? <a href="/login/admin">Admin sign in</a> · Customer? <a href="/login/customer">Sign in</a> · Artisan? <a href="/login/artisan">Maker sign in</a></c:otherwise></c:choose></p><c:if test="${loginRole eq 'ARTISAN'}"><p class="muted-copy">New artisan listings remain hidden until the profile is approved by an administrator.</p></c:if></div></section><%@ include file="fragments/foot.jspf" %>
