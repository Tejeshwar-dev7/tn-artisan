<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="container section-pad"><div class="eyebrow">Marketplace operations</div><h1 class="page-title">Admin workspace</h1><div class="panel mb-4"><h2>Approve access to selling</h2><p>Review the artisan verification queue below, then choose Approve to allow that maker to publish products. Reject keeps publishing blocked. Customer and artisan registration cannot create an administrator.</p><a class="btn btn-outline-dark rounded-pill" href="/products">View marketplace</a></div><div class="stats-row"><div><small>USERS</small><b><c:out value="${users}"/></b></div><div><small>LISTINGS</small><b><c:out value="${products}"/></b></div><div><small>ORDERS</small><b><c:out value="${orders.size()}"/></b></div><div><small>AWAITING REVIEW</small><b><c:out value="${pending.size()}"/></b></div></div><div class="row g-4 mt-2"><div class="col-lg-5"><div class="panel"><h2>Artisan verification queue</h2><c:forEach items="${pending}" var="p"><div class="verify-card"><b><c:out value="${p.shopName}"/></b><div class="maker"><c:out value="${p.craft}"/> &#183; <c:out value="${p.district}"/> &#183; <c:out value="${p.user.email}"/></div><form method="post" action="/admin/artisan/${p.id}" class="d-flex gap-2 mt-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input name="note" class="form-control" placeholder="Review note"><button name="decision" value="approve" class="btn btn-sm btn-success">Approve</button><button name="decision" value="reject" class="btn btn-sm btn-outline-danger">Reject</button></form></div></c:forEach><c:if test="${empty pending}"><p>No profiles are waiting for review.</p></c:if></div></div><div class="col-lg-7"><div class="panel"><h2>Order monitor</h2><c:forEach items="${orders}" var="o"><div class="order-row"><div><b>AC-<c:out value="${o.id}"/> &#183; <c:out value="${o.customer.name}"/></b><div class="maker"><c:out value="${o.status}"/></div></div><b>&#8377;<c:out value="${o.total}"/></b></div></c:forEach><c:if test="${empty orders}"><p>No orders yet.</p></c:if></div></div></div><div class="panel mt-4"><h2>Registered accounts</h2><p class="maker">Account emails and roles are stored in the users table in the configured database.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th><th>Status</th></tr></thead><tbody><c:forEach items="${accounts}" var="account"><tr><td><c:out value="${account.name}"/></td><td><c:out value="${account.email}"/></td><td><c:out value="${account.role}"/></td><td><c:out value="${account.createdAt}"/></td><td><c:out value="${account.active ? 'Active' : 'Disabled'}"/></td></tr></c:forEach></tbody></table></div></div></section><%@ include file="fragments/foot.jspf" %>
