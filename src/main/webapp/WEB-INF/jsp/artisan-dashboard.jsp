<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/head.jspf" %><section class="container section-pad"><div class="account-heading"><div><div class="eyebrow">Maker studio</div><h1 class="page-title">Vanakkam, <c:out value="${profile.shopName}"/>.</h1></div><a class="btn btn-outline-dark rounded-pill" href="/artisan/profile">Workshop profile &#8599;</a></div><nav class="seller-nav"><a href="/artisan/${profile.user.id}">View public profile</a><a href="/artisan/profile">Edit profile</a><a href="#seller-orders">Customer orders</a><a href="#seller-earnings">Earnings</a></nav><div id="seller-earnings" class="seller-metrics"><article>Customer orders<strong id="metric-orders">—</strong><small>Paid and COD orders</small></article><article>Payment-confirmed share<strong id="metric-confirmed">—</strong><small>After commission; not a bank payout</small></article><article>Awaiting COD collection<strong id="metric-pending">—</strong><small>Estimated maker share</small></article><article>Commission on paid sales<strong id="metric-commission">—</strong><small>Based on saved order amounts</small></article></div><p id="seller-live" class="dashboard-live" role="status">Connecting to your order records…</p><div class="approval-panel"><span class="status-pill">Profile · <c:out value="${profile.status}"/></span><p><c:choose><c:when test="${profile.status eq 'APPROVED'}">Your studio is approved. New products you publish become visible in the marketplace.</c:when><c:when test="${profile.status eq 'PENDING'}">Your profile is awaiting administrator review. Listings can be published after approval.</c:when><c:otherwise>Your profile needs administrator review before product listings can be published.</c:otherwise></c:choose></p><c:if test="${not empty profile.verificationNote}"><small><c:out value="${profile.verificationNote}"/></small></c:if></div><div class="row g-4 mt-1"><div class="col-lg-7"><div class="panel" id="seller-listings"><h2>Your marketplace listings</h2><c:forEach items="${products}" var="p"><div class="order-row"><div><b><c:out value="${p.name}"/></b> <a href="/artisan-area/product/${p.id}/edit">Edit listing</a><div class="maker"><c:out value="${p.category.name}"/> · <c:out value="${p.district}"/> · <c:out value="${p.stock}"/> in stock</div></div><b>₹<fmt:formatNumber value="${p.price}" groupingUsed="true" minFractionDigits="0" maxFractionDigits="0"/></b></div></c:forEach><c:if test="${empty products}"><p class="muted-copy">Your first listing will appear here after you publish it.</p></c:if></div>
<div id="seller-orders" class="panel mt-4"><h2>Incoming paid / cash-on-delivery orders</h2><c:forEach items="${orders}" var="o"><article class="maker-order-card"><c:set var="sellerOrderTotal" value="0"/><c:forEach items="${o.items}" var="line"><c:if test="${line.artisan.id eq profile.user.id}"><c:set var="sellerOrderTotal" value="${sellerOrderTotal + line.unitPrice * line.quantity}"/></c:if></c:forEach><div class="order-row"><div><b>Order AC-<c:out value="${o.id}"/></b><div class="maker"><c:out value="${o.status}"/> · <c:out value="${o.paymentStatus}"/> · <c:out value="${o.recipientName}"/>, <c:out value="${o.deliveryDistrict}"/></div></div><b>₹<fmt:formatNumber value="${sellerOrderTotal}" groupingUsed="true" minFractionDigits="2" maxFractionDigits="2"/></b></div><c:forEach items="${o.items}" var="i"><c:if test="${i.artisan.id eq profile.user.id}"><div class="maker-order-item"><c:out value="${i.product.name}"/> · Qty <c:out value="${i.quantity}"/></div></c:if></c:forEach><details><summary>Customer and delivery details</summary><p><c:out value="${o.customer.name}"/> &middot; <c:out value="${o.customer.email}"/></p><p><c:out value="${o.recipientName}"/><br><c:out value="${o.shippingAddress}"/><br><c:out value="${o.deliveryPhone}"/></p></details><form method="post" action="/artisan-area/order/${o.id}/status" class="maker-order-update"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Next order step<select class="form-select" name="status"><option>ACCEPTED</option><option>PRODUCTION_STARTED</option><option>QUALITY_CHECK</option><option>PACKED</option><option>SHIPPED</option><option>OUT_FOR_DELIVERY</option><option>DELIVERED</option></select></label><label>Progress note<input class="form-control" name="note" maxlength="450" placeholder="What changed? (optional)"></label><div class="shipping-update-fields"><label>Delivery partner<input class="form-control" name="courierName" maxlength="100" placeholder="Required when shipping"></label><label>Tracking reference<input class="form-control" name="trackingNumber" maxlength="100" placeholder="Required when shipping"></label><label>Courier tracking URL<input class="form-control" name="trackingUrl" type="url" placeholder="https://…"></label><label>Latest reported location<input class="form-control" name="latestLocation" maxlength="180" placeholder="Only enter a real courier update"></label></div><button class="btn btn-terracotta">Save order update</button></form></article></c:forEach><c:if test="${empty orders}"><p class="muted-copy">Paid and cash-on-delivery orders assigned to your listings will appear here.</p></c:if></div>
<div class="panel mt-4"><h2>Sales breakdown</h2><p>Each row includes only your items in the order. COD remains pending until collection is verified.</p><div class="table-responsive"><table class="table"><thead><tr><th>Order</th><th>Payment</th><th>Your sales</th><th>Commission</th><th>Your share</th></tr></thead><tbody id="seller-sales"></tbody></table></div></div></div>
<div class="col-lg-5"><div class="panel"><h2>Publish a craft listing</h2><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><c:if test="${profile.status ne 'APPROVED'}"><div class="alert alert-info">Your maker profile must be approved before products can be listed.</div></c:if><form method="post" action="/artisan-area/product"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Product name<input name="name" class="form-control" required maxlength="160"></label><label>Description<textarea name="description" class="form-control" required maxlength="3000" rows="4"></textarea></label><div class="row"><div class="col"><label>Price · ₹<input name="price" type="number" min="1" step=".01" class="form-control" required></label></div><div class="col"><label>Stock<input name="stock" type="number" min="0" class="form-control" required></label></div></div><label>Approximate dimensions<input name="dimensions" class="form-control" maxlength="180" placeholder="e.g. 30 × 20 × 4 cm"></label><label>Product photo URL · optional HTTPS<input name="imageUrl" type="url" class="form-control" placeholder="Use a direct HTTPS image link"></label><label>Materials<input name="materials" class="form-control" required maxlength="160"></label><label>Technique<input name="technique" class="form-control" required maxlength="100"></label><label>District<input name="district" class="form-control" required maxlength="80"></label><label>Category<select name="categoryId" class="form-select" required><c:forEach items="${categories}" var="c"><option value="${c.id}"><c:out value="${c.name}"/></option></c:forEach></select></label><button class="btn btn-terracotta w-100 mt-3" ${profile.status ne 'APPROVED' ? 'disabled' : ''}>Publish to marketplace</button></form></div></div></div></section><script src="/js/seller-dashboard.js" defer></script><%@ include file="fragments/foot.jspf" %>
