<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/head.jspf" %>
<section class="container section-pad product-page"><a href="/products" class="text-link">&#8592; Back to marketplace</a><div class="row g-5 mt-2"><div class="col-lg-6"><div class="product-hero product-detail-photo tone-${product.id % 5}"><img src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>" class="detail-product-image"><span class="image-label"><c:out value="${product.category.name}"/></span></div><c:if test="${not empty product.imageCredit}"><p class="image-credit-line">Photo: <c:out value="${product.imageCredit}"/><c:if test="${not empty product.imageSource}"> &#183; <a href="<c:out value='${product.imageSource}'/>" target="_blank" rel="noopener">Source and licence</a></c:if></p></c:if></div><div class="col-lg-6 product-detail"><div class="eyebrow"><c:out value="${product.district}"/> &#183; Tamil Nadu</div><h1><c:out value="${product.name}"/></h1><p class="detail-price">&#8377;<fmt:formatNumber value="${product.price}" groupingUsed="true" minFractionDigits="0" maxFractionDigits="0"/></p><p><c:out value="${product.description}"/></p><div class="detail-grid"><div><small>MATERIALS</small><b><c:out value="${product.materials}"/></b></div><div><small>TECHNIQUE</small><b><c:out value="${product.technique}"/></b></div><div><small>APPROX. DIMENSIONS</small><b><c:out value="${product.dimensions}"/></b></div><div><small>AVAILABLE STOCK</small><b><c:out value="${product.stock}"/> pieces</b></div></div><div class="maker-box"><div class="maker-avatar">&#2965;</div><div><small>MAKER</small><a href="/artisan/${product.artisan.id}"><b><c:out value="${product.artisan.name}"/></b></a><div><c:out value="${product.category.name}"/></div></div></div><form method="post" action="/cart/add/${product.id}" class="detail-add-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="detail-qty">Quantity</label><div><input id="detail-qty" class="form-control qty" type="number" name="quantity" value="1" min="1" max="${product.stock}" ${product.stock lt 1 ? 'disabled' : ''}><button class="btn btn-terracotta flex-grow-1" ${product.stock lt 1 ? 'disabled' : ''}>Add to basket <span aria-hidden="true">&#8594;</span></button></div></form><a class="text-link d-inline-block mt-3" href="/passport/${product.id}">View this craft&#8217;s passport &#8599;</a></div></div></section>
<section class="container narrow pb-5" id="reviews"><div class="panel"><h2>Customer reviews</h2><c:choose><c:when test="${empty reviews}"><p>No reviews yet.</p></c:when><c:otherwise><p><strong><fmt:formatNumber value="${average}" maxFractionDigits="1"/> / 5</strong> &#183; ${reviews.size()} reviews</p></c:otherwise></c:choose><c:forEach items="${reviews}" var="r"><article class="mb-3"><b>${r.rating}/5</b><p><c:out value="${r.body}"/></p></article></c:forEach><c:choose><c:when test="${canReview}"><form method="post" action="/customer/reviews/${product.id}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="rating">Your rating</label><select class="form-select" id="rating" name="rating"><option value="5">5 &#8212; Excellent</option><option value="4">4 &#8212; Good</option><option value="3">3 &#8212; Average</option><option value="2">2 &#8212; Fair</option><option value="1">1 &#8212; Poor</option></select><label for="review-body">What did you think?</label><textarea class="form-control" id="review-body" name="body" required minlength="10" maxlength="1200"></textarea><button class="btn btn-terracotta mt-3">Save review</button></form></c:when><c:otherwise><p>Reviews are available to signed-in customers after delivery.</p></c:otherwise></c:choose></div></section><%@ include file="fragments/foot.jspf" %>
