<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="container section-pad narrow"><div class="eyebrow">Verified purchases</div><h1 class="page-title">Customer reviews</h1><p>Customers can leave or update one rating per product after delivery.</p><c:if test="${empty reviews}"><div class="empty-state">No reviews have been published yet.</div></c:if><c:forEach items="${reviews}" var="r"><article class="panel mb-3"><a href="/products/${r.product_id}#reviews"><c:out value="${r.product}"/></a><p><strong>${r.rating}/5</strong></p><p><c:out value="${r.body}"/></p></article></c:forEach></section><%@ include file="fragments/foot.jspf" %>
