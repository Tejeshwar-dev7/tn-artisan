<%@ include file="fragments/head.jspf" %><link rel="stylesheet" href="/css/landing.css"><section class="craft-landing public-maker container section-pad"><a href="/products" class="text-link">&#8592; Explore makers</a><div class="maker-profile mt-4" data-motion><div class="maker-avatar large">&#2965;</div><div><div class="eyebrow"><c:out value="${profile.district}"/> &#183; Tamil Nadu</div><h1><c:out value="${profile.shopName}"/></h1><p class="lead-muted"><c:out value="${profile.craft}"/> &#183; <c:if test="${profile.status eq 'APPROVED'}"><span class="verified">Approved seller</span></c:if></p><p><c:out value="${profile.story}"/></p></div></div><h2 class="mt-5 mb-4">Work from this studio</h2><div class="row g-4"><c:forEach items="${products}" var="p"><div class="col-6 col-lg-3" data-motion><a class="product-card" href="/products/${p.id}"><div class="product-image tone-${p.id % 5}"><img src="<c:out value='${p.imageUrl}'/>" alt="<c:out value='${p.name}'/>" loading="lazy"></div><h3><c:out value="${p.name}"/></h3><div class="maker">&#8377;<c:out value="${p.price}"/></div></a></div></c:forEach></div></section><script src="/js/landing.js" defer></script><%@ include file="fragments/foot.jspf" %>
