<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/head.jspf" %>
<link rel="stylesheet" href="/css/landing.css"><section class="craft-landing market-motion catalog-page"><div class="catalog-shell">
<div class="catalog-title-row"><div><div class="eyebrow">TN ARTISAN &#183; Independent Tamil Nadu marketplace</div><h1>Handmade, with a story in every detail.</h1><p>Browse pottery, painting, metalwork, carving and woven goods from across the state.</p></div><a class="catalog-source-link" href="/about">Meet the artisans &#8599;</a></div>

<div class="catalog-tabs"><a class="${empty selectedCategory ? 'selected' : ''}" href="/products">All products</a><c:forEach items="${categories}" var="c"><a class="${selectedCategory == c.id ? 'selected' : ''}" href="/products?category=${c.id}"><c:out value="${c.name}"/></a></c:forEach></div>
<form class="catalog-filter" method="get"><label class="catalog-search"><span>&#8981;</span><input name="q" value="<c:out value='${q}'/>" placeholder="Search craft, product or material"><button>Search</button></label><label>Sort by<select name="sort"><option value="">Recently added</option><option value="price-low" ${sort == 'price-low' ? 'selected' : ''}>Price: low to high</option><option value="price-high" ${sort == 'price-high' ? 'selected' : ''}>Price: high to low</option><option value="name" ${sort == 'name' ? 'selected' : ''}>Name</option></select></label><label>Min &#8377;<input name="minPrice" type="number" min="0" step="1" value="<c:out value='${minPrice}'/>" placeholder="Any"></label><label>Max &#8377;<input name="maxPrice" type="number" min="0" step="1" value="<c:out value='${maxPrice}'/>" placeholder="Any"></label><label class="stock-filter"><input type="checkbox" name="inStock" value="true" ${inStock ? 'checked' : ''}> In stock</label><c:if test="${not empty selectedCategory}"><input type="hidden" name="category" value="${selectedCategory}"></c:if><button class="filter-submit">Apply filters</button><span class="catalog-count"><b><c:out value="${products.size()}"/></b> products</span></form>
<div class="listing-grid marketplace-grid"><c:forEach items="${products}" var="p"><article class="listing-card marketplace-card" data-motion><a class="listing-photo market-product-photo tone-${p.id % 5}" href="/products/${p.id}"><img src="<c:out value='${p.imageUrl}'/>" alt="<c:out value='${p.name}'/>" loading="lazy"><span class="listing-category"><c:out value="${p.category.name}"/></span><span class="photo-zoom" aria-hidden="true">&#8599;</span></a><div class="listing-info"><div class="listing-sub"><span><c:out value="${p.district}"/></span><span><c:out value="${p.dimensions}"/></span></div><a class="market-product-title" href="/products/${p.id}"><h2><c:out value="${p.name}"/></h2></a><div class="listing-price"><span>&#8377;<fmt:formatNumber value="${p.price}" groupingUsed="true" minFractionDigits="0" maxFractionDigits="0"/></span><small><c:out value="${p.materials}"/></small></div><div class="market-meta"><span><c:out value="${p.stock}"/> in stock</span><a href="/products/${p.id}#reviews"><c:choose><c:when test="${not empty reviewStats[p.id]}">&#9733; <fmt:formatNumber value="${reviewStats[p.id].average}" maxFractionDigits="1"/> <span>(<c:out value="${reviewStats[p.id].count}"/>)</span></c:when><c:otherwise>No reviews yet</c:otherwise></c:choose></a></div><form method="post" action="/cart/add/${p.id}" class="market-add-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Qty <input type="number" name="quantity" value="1" min="1" max="${p.stock}" aria-label="Quantity" ${p.stock lt 1 ? 'disabled' : ''}></label><button type="submit" ${p.stock lt 1 ? 'disabled' : ''}><span>Add to basket</span><b aria-hidden="true">&#8594;</b></button></form></div></article></c:forEach></div>
<c:if test="${empty products}"><div class="empty-state">No maker listings match those filters. Try another craft or clear the price range.</div></c:if>
<a class="artisan-feature" href="/for-sellers"><div><span class="eyebrow">Made with care &#183; built for makers</span><h2>Make room for handmade.</h2><p>Tell the story behind your craft and bring your work to people who value it.</p><span class="artisan-feature-button">Open an artisan studio &#8599;</span></div><div class="artisan-feature-art"><span>&#2965;&#3016;&#2997;&#3007;&#2985;&#3016;</span><small>THE HANDS BEHIND THE OBJECT</small></div></a>
</div></section><script src="/js/landing.js" defer></script><%@ include file="fragments/foot.jspf" %>
