<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ include file="fragments/head.jspf" %><section class="auth-wrap"><div class="auth-card"><div class="eyebrow"><c:choose><c:when test="${preferredRole eq 'ARTISAN'}">Join as a maker</c:when><c:when test="${preferredRole eq 'CUSTOMER'}">Join as a customer</c:when><c:otherwise>Join TN ARTISAN</c:otherwise></c:choose></div><h1><c:choose><c:when test="${preferredRole eq 'ARTISAN'}">Create your artisan account</c:when><c:when test="${preferredRole eq 'CUSTOMER'}">Create your customer account</c:when><c:otherwise>Create your TN ARTISAN account</c:otherwise></c:choose></h1><c:if test="${not empty param.email}"><div class="alert alert-info">No account was found for <b><c:out value="${param.email}"/></b>. Create one here.</div></c:if><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}"/></div></c:if><form method="post" action="/register"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Your name</label><input class="form-control" name="name" required maxlength="120"><label>Email</label><input class="form-control" type="email" name="email" value="<c:out value='${param.email}'/>" required autocomplete="email"><label>Password · at least 8 characters</label><input class="form-control" type="password" name="password" minlength="8" required autocomplete="new-password"><c:choose><c:when test="${not empty preferredRole}"><input type="hidden" name="role" value="<c:out value='${preferredRole}'/>"><div class="role-fixed"><c:out value="${preferredRole eq 'ARTISAN' ? 'Artisan / craft collective' : 'Customer'}"/></div></c:when><c:otherwise><label>I am joining as</label><select class="form-select" name="role" id="role"><option value="CUSTOMER" selected>Customer</option><option value="ARTISAN">Artisan / craft collective</option></select></c:otherwise></c:choose><div id="artisanFields" ${preferredRole eq 'ARTISAN' ? '' : 'hidden'}><label>Studio / group name</label><input class="form-control" name="shopName"><label>Craft tradition</label><input class="form-control" name="craft"><label>District</label><input class="form-control" name="district"></div><button class="btn btn-terracotta w-100 mt-4">Create account</button></form><p class="mt-3">Already have an account? <c:choose><c:when test="${preferredRole eq 'ARTISAN'}"><a href="/login/artisan">Sign in to maker studio</a></c:when><c:otherwise><a href="/login/customer">Sign in to customer account</a></c:otherwise></c:choose></p><c:if test="${preferredRole eq 'ARTISAN'}"><div class="alert alert-info">Your profile starts as pending. An administrator must approve it before you can publish products to the marketplace.</div></c:if></div></section><script>const roleSelect=document.getElementById('role');if(roleSelect)roleSelect.addEventListener('change',()=>document.getElementById('artisanFields').hidden=roleSelect.value!=='ARTISAN');</script><%@ include file="fragments/foot.jspf" %>
