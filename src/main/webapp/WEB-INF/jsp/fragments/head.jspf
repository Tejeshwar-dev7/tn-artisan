<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>TN ARTISAN &#183; Tamil Nadu crafts</title><link rel="icon" href="/images/tn-mark.svg"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/app.css" rel="stylesheet"><link href="/css/organic.css" rel="stylesheet"><link href="/css/catalog.css" rel="stylesheet"><link href="/css/tn.css" rel="stylesheet"><link href="/css/checkout-tracking.css" rel="stylesheet"></head><body>
<header class="tn-header"><div class="tn-header-top container"><a class="tn-brand" href="/"><img src="/images/tn-mark.svg" width="42" height="42" alt="">TN ARTISAN</a><form class="nav-search" action="/products"><input name="q" aria-label="Search marketplace" placeholder="Search handmade crafts"><button aria-label="Search">&#8981;</button></form><div class="tn-account"><a href="/cart">Basket</a><c:choose><c:when test="${pageContext.request.userPrincipal != null}"><a href="/account">Account</a><form method="post" action="/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Sign out</button></form></c:when><c:otherwise><a href="/login">Sign in</a></c:otherwise></c:choose></div></div>
