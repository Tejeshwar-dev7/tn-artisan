<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/head.jspf" %>
<section class="container section-pad narrow payment-page"><div class="eyebrow">Order AC-<c:out value="${order.id}"/> · payment</div><h1 class="page-title">Complete your payment securely.</h1><div class="payment-card panel"><p class="payment-caption">Payable amount</p><div class="detail-price">₹<fmt:formatNumber value="${order.total}" groupingUsed="true" minFractionDigits="2" maxFractionDigits="2"/></div><p>Razorpay’s secure checkout will open next. Available methods depend on your merchant account and device; UPI apps such as Google Pay may appear when enabled.</p><div class="payment-order-brief"><b>Delivering to</b><span><c:out value="${order.recipientName}"/> · <c:out value="${order.deliveryCity}"/>, <c:out value="${order.deliveryDistrict}"/> · PIN <c:out value="${order.deliveryPostalCode}"/></span><small>Your exact address is stored on order AC-<c:out value="${order.id}"/>.</small></div><button class="btn btn-terracotta w-100 mt-4" id="razorpay-open">Open secure payment</button><p class="payment-safe">TN ARTISAN never receives or stores your card or UPI credentials. Payment is accepted only after server-side verification.</p><form id="payment-callback" method="post" action="/checkout/verify"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="orderId" value="${order.id}"><input type="hidden" name="razorpay_order_id"><input type="hidden" name="razorpay_payment_id"><input type="hidden" name="razorpay_signature"></form><form id="payment-failure" method="post" action="/checkout/payment-failed"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="orderId" value="${order.id}"><input type="hidden" name="reason" value="provider reported failed payment"></form></div><a href="/customer/orders/${order.id}" class="text-link d-inline-block mt-3">View order status</a></section>
<div hidden id="payment-config" data-key="<c:out value='${keyId}'/>" data-amount="<c:out value='${amountPaise}'/>" data-order="<c:out value='${order.providerOrderId}'/>" data-local-order="<c:out value='${order.id}'/>" data-name="<c:out value='${order.recipientName}'/>" data-phone="<c:out value='${order.deliveryPhone}'/>"></div><script src="https://checkout.razorpay.com/v1/checkout.js"></script><script>
(()=>{const button=document.getElementById('razorpay-open');const cfg=document.getElementById('payment-config');if(!button||!cfg)return;button.addEventListener('click',()=>{const options={key:cfg.dataset.key,amount:cfg.dataset.amount,currency:'INR',name:'TN ARTISAN',description:'Order AC-'+cfg.dataset.localOrder,order_id:cfg.dataset.order,prefill:{name:cfg.dataset.name,contact:cfg.dataset.phone},theme:{color:'#145e4d'},handler:(response)=>{const form=document.getElementById('payment-callback');form.elements.razorpay_order_id.value=response.razorpay_order_id;form.elements.razorpay_payment_id.value=response.razorpay_payment_id;form.elements.razorpay_signature.value=response.razorpay_signature;form.submit();}};const checkout=new Razorpay(options);checkout.on('payment.failed',()=>document.getElementById('payment-failure').submit());checkout.open();});})();
</script><%@ include file="fragments/foot.jspf" %>
